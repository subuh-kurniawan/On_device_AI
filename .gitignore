# =========================================================================
# Git Ignore Rules - On_device_AI
# =========================================================================

# 1. Skrip Otomasi Lokal Pribadi
git_push.command
*.command.local

# 2. Sertifikat SSL, Kunci Privat, & Dokumen Kredensial
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
cert.pem
key.pem

# 3. Kredensial, Token, & Environment Variables
.env
.env.*
*.token
*token*.txt
*credential*
*secret*

# 4. Binary Hasil Kompilasi & Cache Build (Khusus jalankanserverFN_gui disertakan untuk Mac Apple Silicon)
*.o
*.obj
*.dylib
*.so
*.dSYM/
/Archive.zip

# 5. OS & Editor Artifacts
.DS_Store
**/.DS_Store
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 6. Log & File Sementara
.wiki_git/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
